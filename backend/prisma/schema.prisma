generator client {
  provider = "prisma-client"
  output   = "./generated"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// defining the schema

model User{
  id               String          @id      @default(uuid()) 
  email            String          @unique
  provider         AuthProvider
  name             String
  conversations    Conversation[]
}

enum AuthProvider {
  Github
  Google
}

model Conversation {
  id                 String         @id     @default(uuid())
  title              String?
  slug               String
  userId             String
  messages           Message[]
  user               User          @relation(fields: [userId], references: [id])
}

model Message {
  id                 Int         @id    @default(autoincrement())
  content            String
  role               MessageRole
  conversationId     String
  conversation       Conversation     @relation(fields: [conversationId], references: [id])
  createdAt          DateTime      @default(now())
}

enum MessageRole {
  User
  Assistant
}